{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],

  enabledManagers: ['custom.jsonata'],

  // default 2: with one PR per image, a daily run would open at most 2
  prHourlyLimit: 0,

  // no auto-detected conventional-commit prefix or lower-casing of titles
  semanticCommits: 'disabled',

  // add the `Image` column to the preexising default columns
  // it is defined only for docker-datasource updates (packageRules below)
  // empty columns are omitted
  prBodyColumns: ['Package', 'Image', 'Type', 'Update', 'Change', 'Pending'],

  customManagers: [
    {
      customType: 'jsonata',
      description: 'OCI image pins in images.toml',
      fileFormat: 'toml',
      managerFilePatterns: ['/(^|/)images\\.toml$/'],
      matchStrings: [
        // depName: images.toml table name, used in PR titles and branch names
        // packageName: registry repository, used for the lookup
        '$each(function($v, $k) { { "depName": $k, "packageName": $v.repository, "currentValue": $v.tag, "currentDigest": $v.digest } })',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
  ],

  packageRules: [
    {
      description: 'One PR per image, majors included, titled "<name>: <old tag> -> <new tag>"',
      matchManagers: ['custom.jsonata'],
      separateMajorMinor: false,
      // the three parts are joined with spaces (empty ones dropped)
      commitMessageAction: '',
      commitMessageTopic: '{{{depName}}}:',
      commitMessageExtra: '{{{currentValue}}} -> {{{newValue}}}',
    },
    {
      description: 'Link to the image page in the PR table',
      matchDatasources: ['docker'],
      // try to reconstruct the full link to the image page
      prBodyDefinitions: {
        Image: "{{#if (containsString packageName 'ghcr.io/')}}[{{{packageName}}}](https://{{{packageName}}}){{else if (containsString packageName 'codeberg.org/')}}[{{{packageName}}}:{{{newValue}}}](https://codeberg.org/{{lookup (split packageName '/') 1}}/-/packages/container/{{lookup (split packageName '/') 2}}/{{{newValue}}}){{else}}[{{{packageName}}}:{{{newValue}}}](https://hub.docker.com/r/{{{packageName}}}/tags?name={{{newValue}}}){{/if}}",
      },
    },
    {
      description: 'No PR for a new digest under an unchanged tag',
      matchManagers: ['custom.jsonata'],
      matchUpdateTypes: ['digest'],
      enabled: false,
    },
  ],
}
